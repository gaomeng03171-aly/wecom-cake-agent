# FastAPI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ADMIN_API_KEY=

# 数据库
DATABASE_URL=sqlite:///./dev.db

# Dify
DIFY_CLIENT_MODE=mock
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_USER=wecom-dinner-agent
DIFY_TIMEOUT_SECONDS=30

# 企业微信
WECOM_SENDER_MODE=mock
WECOM_WEBHOOK_URL=
WECOM_SENDER_TIMEOUT_SECONDS=10
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=

# 提醒调度
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=30
