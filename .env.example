# FastAPI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ADMIN_API_KEY=

# 数据库
DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true

# Dify
DIFY_CLIENT_MODE=mock
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_USER=wecom-dinner-agent
DIFY_TIMEOUT_SECONDS=30

# 企业微信
# mock / app / webhook / aibot_ws
WECOM_SENDER_MODE=mock
WECOM_WEBHOOK_URL=
WECOM_API_BASE=https://qyapi.weixin.qq.com
WECOM_SENDER_TIMEOUT_SECONDS=10
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_MAX_AGE_SECONDS=300

# 智能机器人长连接
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_NAME=
WECOM_AIBOT_REQUIRE_MENTION=true

# 提醒调度
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=30

# 部署
APP_DOMAIN=localhost
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
