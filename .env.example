# FastAPI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Hong_Kong
# order / dinner
AGENT_SCENARIO=order
ADMIN_API_KEY=

# 数据库
DATABASE_URL=sqlite:///./dev.db
AUTO_CREATE_TABLES=true

# Dify
DIFY_CLIENT_MODE=mock
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_USER=wecom-cake-agent
DIFY_TIMEOUT_SECONDS=30

# 订单 Dify（auto 优先复用通用 Dify Key，mock 用本地规则，real 用订单专用配置）
ORDER_DIFY_MODE=auto
DIFY_ORDER_API_BASE=
DIFY_ORDER_API_KEY=
DIFY_ORDER_USER=wecom-order-agent
DIFY_ORDER_TIMEOUT_SECONDS=30

# 企业微信
# mock / app / webhook / aibot_ws
WECOM_SENDER_MODE=mock
WECOM_WEBHOOK_URL=
WECOM_API_BASE=https://qyapi.weixin.qq.com
WECOM_SENDER_TIMEOUT_SECONDS=10
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_MAX_AGE_SECONDS=300

# 智能机器人长连接
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=
WECOM_AIBOT_NAME=
WECOM_AIBOT_REQUIRE_MENTION=true
WECOM_OWNER_USER_ID=
# auto / app / webhook / active
ORDER_NOTIFICATION_CHANNEL=auto

# 提醒调度
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=30

# Outbox 重试
OUTBOX_RETRY_POLL_SECONDS=5
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=300

# 部署
APP_DOMAIN=localhost
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
